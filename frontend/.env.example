# Copy this file to .env.local and fill in the values from
# Firebase console → Project settings → Your apps → Web app config
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Backend API (defaults to http://localhost:5000/api)
VITE_API_URL=

# Public site address used in shareable profile links, e.g. https://tied.app
# (defaults to the address the app is opened on)
VITE_PUBLIC_URL=

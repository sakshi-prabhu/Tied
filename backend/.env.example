PORT=5000
MONGO_URI=mongodb+srv://<user>:<password>@<cluster>/tied
FIREBASE_PROJECT_ID=tied-ae4fa
# Secret used to hash visitor IPs for analytics deduplication
ANALYTICS_SECRET=change-me
# Number of proxies in front of the API (e.g. 1 on Render/Railway); leave empty when running locally
TRUST_PROXY=
# Allowed frontend origin(s), comma-separated, e.g. https://tied.vercel.app; leave empty to allow all
CORS_ORIGIN=
